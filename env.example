# Verium RPC Explorer Environment Configuration
# Copy this file to .env and update the values for your setup

# Verium Node RPC Configuration
# Format: bitcoin://username:password@host:port/
# Default Verium port is 36988
BTCEXP_BITCOIND_URI=bitcoin://rpcuser:rpcpassword@127.0.0.1:36988/

# Alternative: Use individual RPC settings
 BTCEXP_BITCOIND_HOST=127.0.0.1
 BTCEXP_BITCOIND_PORT=36988
 BTCEXP_BITCOIND_USER=rpcuser
 BTCEXP_BITCOIND_PASS=rpcpassword

# Address API Configuration (optional)
# Options: electrum, blockchain.com, blockchair.com, blockcypher.com
BTCEXP_ADDRESS_API=electrum

# Electrum Servers (if using electrum address API)
# Comma-separated list of electrum servers
BTCEXP_ELECTRUM_SERVERS=tcp://127.0.0.1:50001

# UI Configuration
BTCEXP_UI_THEME=dark
BTCEXP_SLOW_DEVICE_MODE=false

# Privacy and External Data
# Set to true to disable external API calls (exchange rates, etc.)
BTCEXP_PRIVACY_MODE=false
# Set to true to disable exchange rate fetching
BTCEXP_NO_RATES=false

# Demo Mode
# Set to true to enable demo features
BTCEXP_DEMO=false

# Docker User Configuration (uncomment and set if needed)
# UID=1000
# GID=1000

# API abuse prevention (explorer-api /v1, Next BFF, legacy Express)
# VCEXP_RATE_LIMIT_WINDOW_MINUTES=15
# VCEXP_RATE_LIMIT_MAX=20000
# VCEXP_RATE_LIMIT_CRAWLER_MAX=800
# VCEXP_RATE_LIMIT_HEAVY_MAX=600
# VCEXP_RATE_LIMIT_SSE_MAX=32
# VCEXP_RATE_LIMIT_ALLOW_IPS=
# VCEXP_REDIS_URL=
# EXPLORER_RPC_RATE_LIMIT_MAX=10
# EXPLORER_BFF_RATE_LIMIT_MAX=20000
# EXPLORER_AUTH_RATE_LIMIT_MAX=30
# BTCEXP_RATE_LIMIT_WINDOW_MINUTES=15
# BTCEXP_RATE_LIMIT_WINDOW_MAX_REQUESTS=20000
# BTCEXP_RATE_LIMIT_CRAWLER_MAX_REQUESTS=800
