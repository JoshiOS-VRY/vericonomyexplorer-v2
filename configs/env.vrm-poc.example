# Verium proof-of-concept explorer environment
#
# Copy these into your container env, compose file, or local .env.
# Do not commit real RPC passwords.

BTCEXP_HOST=127.0.0.1
BTCEXP_PORT=3002

# Legacy btc-rpc-explorer RPC path, used by the existing block/node pages.
BTCEXP_BITCOIND_HOST=127.0.0.1
BTCEXP_BITCOIND_PORT=33987
BTCEXP_BITCOIND_USER=replace-me
BTCEXP_BITCOIND_PASS=replace-me
BTCEXP_BITCOIND_RPC_TIMEOUT=30000

# Indexer V2 path, used by /vrm pages and /api/indexer routes.
VCEXP_INDEXER_SQLITE_PATH=/data/vericonomy-index.sqlite
VCEXP_CHAINS_CONFIG=./configs/chains.vrm-poc.example.json

# Verium RPC path, used by the indexer worker.
VCEXP_VRM_RPC_USER=replace-me
VCEXP_VRM_RPC_PASS=replace-me
