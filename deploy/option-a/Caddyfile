{
  email {$ACME_EMAIL}
  admin off
}

# Production + staging share the same Next.js + FastAPI stack.
{$PUBLIC_DOMAIN}, {$STAGING_DOMAIN} {
  # API + SSE: bypass Next.js (rewrites are build-time) and avoid compressing event streams.
  # Application rate limits live in explorer-api (VCEXP_RATE_LIMIT_*). Optional coarse edge
  # limiting: https://caddyserver.com/docs/modules/http.handlers.rate_limit
  # Example: rate_limit { zone public_api { key {remote_ip} events 50 window 1s} }
  handle /v1/* {
    reverse_proxy explorer-fast-api:3003
  }

  handle {
    encode zstd gzip

    header {
      Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
      X-Content-Type-Options "nosniff"
      X-Frame-Options "SAMEORIGIN"
      Referrer-Policy "strict-origin-when-cross-origin"
    }

    reverse_proxy explorer-web:3000
  }
}

# Keep legacy Express routes public on a dedicated hostname.
{$LEGACY_PUBLIC_DOMAIN}, {$LEGACY_STAGING_DOMAIN} {
  encode zstd gzip
  reverse_proxy explorer-express:3002
}
