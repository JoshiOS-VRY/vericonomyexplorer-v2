{
  email {$ACME_EMAIL}
  admin off
}

{$PUBLIC_DOMAIN} {
  # API + SSE: bypass Next.js (rewrites are build-time) and avoid compressing event streams.
  handle /v1/* {
    reverse_proxy vericonomy-explorer-fast-api:3003
  }

  handle {
    encode zstd gzip

    header {
      Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
      X-Content-Type-Options "nosniff"
      X-Frame-Options "SAMEORIGIN"
      Referrer-Policy "strict-origin-when-cross-origin"
    }

    reverse_proxy vericonomy-explorer-web:3000
  }
}

# Keep legacy Express routes public on a dedicated hostname.
{$LEGACY_PUBLIC_DOMAIN} {
  encode zstd gzip
  reverse_proxy vericonomy-explorer-express:3002
}
