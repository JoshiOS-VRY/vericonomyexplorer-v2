{
  email {$ACME_EMAIL}
  admin off
}

# Production — explorer.vericonomy.com (main branch checkout + deploy-prod.sh)
{$PUBLIC_DOMAIN} {
  handle_path /push/* {
    reverse_proxy vericonomy-push-api:8080
  }

  handle /v1/* {
    reverse_proxy vericonomy-explorer-fast-api:3003 {
      header_up X-Real-IP {http.request.header.CF-Connecting-IP}
    }
  }

  handle {
    encode zstd gzip

    header {
      Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
      X-Content-Type-Options "nosniff"
      X-Frame-Options "SAMEORIGIN"
      Referrer-Policy "strict-origin-when-cross-origin"
    }

    reverse_proxy vericonomy-explorer-web:3000
  }
}

# Staging — staging-explorer.vericonomy.com (staging branch checkout + deploy-staging.sh)
{$STAGING_DOMAIN} {
  handle /v1/* {
    reverse_proxy vericonomy-explorer-fast-api-staging:3013 {
      header_up X-Real-IP {http.request.header.CF-Connecting-IP}
    }
  }

  handle {
    encode zstd gzip

    header {
      X-Robots-Tag "noindex, nofollow"
      Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
      X-Content-Type-Options "nosniff"
      X-Frame-Options "SAMEORIGIN"
      Referrer-Policy "strict-origin-when-cross-origin"
    }

    reverse_proxy vericonomy-explorer-web-staging:3010
  }
}

# Legacy Express (production hostname only)
{$LEGACY_PUBLIC_DOMAIN} {
  encode zstd gzip
  reverse_proxy vericonomy-explorer-express:3002
}

http://electrumx-vrm3.vericonomy.com {
  root * /var/www/acme
  handle /.well-known/acme-challenge/* {
    file_server
  }
  respond 404
}

http://electrumx-vrc3.vericonomy.com {
  root * /var/www/acme
  handle /.well-known/acme-challenge/* {
    file_server
  }
  respond 404
}

push.vericonomy.com {
  reverse_proxy vericonomy-push-api:8080
}
