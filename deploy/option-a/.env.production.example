# Domain and TLS
PUBLIC_DOMAIN=explorer-vrm.vericonomy.com
LEGACY_PUBLIC_DOMAIN=legacy-explorer-vrm.vericonomy.com
ACME_EMAIL=admin@vericonomy.com

# Web / service ports inside the Docker network
WEB_PORT=3000
EXPRESS_PORT=3002
FAST_API_PORT=3003

# Core app env
NODE_ENV=production
BTCEXP_COIN=VRM
BTCEXP_DISPLAY_CURRENCY=vrm
BTCEXP_UI_THEME=dark
BTCEXP_HOST=0.0.0.0
BTCEXP_PORT=3002

# Legacy Express RPC path
BTCEXP_BITCOIND_HOST=127.0.0.1
BTCEXP_BITCOIND_PORT=33987
BTCEXP_BITCOIND_USER=replace-me
BTCEXP_BITCOIND_PASS=replace-me
BTCEXP_BITCOIND_RPC_TIMEOUT=30000
BTCEXP_RPC_CONCURRENCY=10

# Optional auth gate for /admin/* in Next
EXPLORER_ADMIN_TOKEN=

# Indexer / shared storage
VCEXP_INDEXER_SQLITE_PATH=/app/database/vericonomy-index.sqlite
VCEXP_CHAINS_CONFIG=/app/configs/chains.json
VCEXP_TIP_POLL_MS=3000

# Fast API runtime
VCEXP_FAST_API_HOST=0.0.0.0
VCEXP_FAST_API_PORT=3003
EXPLORER_FAST_API_URL=http://explorer-fast-api:3003

# Next backend targets
EXPLORER_API_URL=http://explorer-express:3002

# RPC credentials consumed by app/indexerV2/chainConfig.js
VCEXP_VRM_RPC_USER=replace-me
VCEXP_VRM_RPC_PASS=replace-me
VCEXP_VRM_RPC_COOKIE=
VCEXP_VRM_ZMQ=tcp://127.0.0.1:28332

# Optional VRC placeholders (future use)
VCEXP_VRC_RPC_USER=
VCEXP_VRC_RPC_PASS=
VCEXP_VRC_RPC_COOKIE=
VCEXP_VRC_ZMQ=tcp://127.0.0.1:28333
