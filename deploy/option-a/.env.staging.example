# Staging stack — copy to .env.staging in the staging git checkout on the VPS.
# Shares prod SQLite / Postgres / indexers; only UI + FastAPI differ from production.

STAGING_DOMAIN=staging-explorer.vericonomy.com
NEXT_PUBLIC_SITE_URL=https://staging-explorer.vericonomy.com
EXPLORER_SITE_URL=https://staging-explorer.vericonomy.com

# Internal ports (must match docker-compose.staging.yml and Caddyfile)
STAGING_WEB_PORT=3010
STAGING_FAST_API_PORT=3013

# Prod compose project on the same droplet (for external network + DB volume names)
PROD_COMPOSE_PROJECT=vericonomyexplorer-v2
EXPLORER_PROD_ROOT=/root/vericonomyexplorer-v2

# Git branch tracked by this checkout
STAGING_GIT_BRANCH=staging
STAGING_GIT_REMOTE=https://github.com/JoshiOS-VRY/vericonomyexplorer-v2.git

# Copy RPC + DB settings from .env.production (same nodes and index DB)
NODE_ENV=production
VCEXP_DB_BACKEND=sqlite
VCEXP_INDEXER_SQLITE_PATH=/app/database/vericonomy-index.sqlite
VCEXP_CHAINS_CONFIG=/app/configs/chains.json
VCEXP_VRM_RPC_HOST=172.18.0.1
VCEXP_VRC_RPC_HOST=172.18.0.1
VCEXP_VRM_RPC_USER=replace-me
VCEXP_VRM_RPC_PASS=replace-me
VCEXP_VRC_RPC_USER=replace-me
VCEXP_VRC_RPC_PASS=replace-me
VCEXP_PG_URL=postgres://vericonomy:replace-me@vericonomy-postgres:5432/vericonomy

# Optional: basic auth for staging (leave blank for open staging)
# BTCEXP_BASIC_AUTH_PASSWORD=
