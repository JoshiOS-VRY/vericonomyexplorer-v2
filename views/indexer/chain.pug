extends ../layout

- const base = chainBasePath || "./vrm"
- const meta = chainMeta || { name: "Verium", ticker: "VRM", logo: "./img/vericonomy/verium-logo.svg", pageTitle: "Verium Explorer" }

block headContent
	title #{meta.pageTitle}

block content
	.vce-shell
		section.vce-page-hero
			.vce-page-title
				img(src=assetUrl(meta.logo), alt="")
				div
					h1 #{meta.name} Explorer
					p #{meta.ticker} explorer powered by the trusted genesis index.
			form.vce-search(method="post", action=`${base}/search`)
				input(type="hidden", name="_csrf", value=csrfToken)
				input(type="text", name="query", placeholder=meta.searchPlaceholder, autocomplete="off", spellcheck="false")
				button(type="submit")
					i.bi-search
					span Search
			.vce-stat-bar
				div
					span Current Block
					strong #{summary.health.heights.maxIndexedHeight == null ? "N/A" : summary.health.heights.maxIndexedHeight.toLocaleString()}
				div
					span RPC Tip
					strong #{summary.health.heights.bestRpcHeight == null ? "N/A" : summary.health.heights.bestRpcHeight.toLocaleString()}
				div
					span Blocks Behind
					strong #{summary.health.heights.blocksBehind == null ? "N/A" : summary.health.heights.blocksBehind.toLocaleString()}
				div
					span Trust
					strong #{summary.health.status}
			if tipSync && tipSync.remainingBehind > 0
				p.vce-sync-note Index caught up through block #{tipSync.endHeight.toLocaleString()}; #{tipSync.remainingBehind.toLocaleString()} block(s) still syncing in the background.

		section.vce-section.vce-split
			.vce-panel
				.vce-panel-head
					h2 Latest Blocks
					span.vce-source #{summary.health.sourceLabels.blocks}
				.vce-table-wrap
					table.vce-table
						thead
							tr
								th Height
								th Hash
								th Tx
								th Time
						tbody
							each block in summary.latestBlocks
								tr
									td
										a(href=`${base}/block/${block.height}`) #{block.height.toLocaleString()}
									td.vce-mono
										a(href=`${base}/block/${block.hash}`) #{utils.ellipsizeMiddle(block.hash, 26)}
									td #{block.txCount.toLocaleString()}
									td
										+timestamp(block.time, {agoOptions:{oneElement:true}})

			.vce-panel
				.vce-panel-head
					h2 Top Balances
					a(href=`${base}/richlist`) Full richlist
				if (!richlist.enabled && richlist.message)
					.vce-empty #{richlist.message}
				else if richlist.items && richlist.items.length
					.vce-rank-list
						each item in richlist.items
							a.vce-rank-row(href=`${base}/address/${item.address}`)
								span ##{item.rank}
								strong.vce-mono #{utils.ellipsizeMiddle(item.address, 20)}
								em #{item.balance.amount} #{item.balance.ticker}
				else
					.vce-empty No indexed balances yet.

		section.vce-section.vce-split
			.vce-panel
				.vce-panel-head
					h2 Recent Transactions
					span.vce-source #{summary.health.sourceLabels.transactions}
				.vce-table-wrap
					table.vce-table
						thead
							tr
								th Txid
								th Block
								th Type
								th Time
						tbody
							each tx in summary.recentTransactions
								tr
									td.vce-mono
										a(href=`${base}/tx/${tx.txid}`) #{utils.ellipsizeMiddle(tx.txid, 32)}
									td
										a(href=`${base}/block/${tx.blockHeight}`) #{tx.blockHeight.toLocaleString()}
									td
										if tx.isCoinbase
											span.vce-chip coinbase
										else if tx.isCoinstake
											span.vce-chip coinstake
										else
											span transfer
									td
										+timestamp(tx.time, {agoOptions:{oneElement:true}})

			.vce-panel
				.vce-panel-head
					h2 Monthly Activity
					a(href=`${base}/leaderboard?period=month&sort=activity`) Full leaderboard
				if (!leaderboard.enabled && leaderboard.message)
					.vce-empty #{leaderboard.message}
				else if leaderboard.items && leaderboard.items.length
					.vce-rank-list
						each item in leaderboard.items
							a.vce-rank-row(href=`${base}/address/${item.address}`)
								span ##{item.rank}
								strong.vce-mono #{utils.ellipsizeMiddle(item.address, 20)}
								em #{item.txCount.toLocaleString()} tx
				else
					.vce-empty No leaderboard activity in this period.
