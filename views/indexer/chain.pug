extends ../layout

block headContent
	title Verium Explorer

block content
	.vce-shell
		section.vce-page-hero
			.vce-page-title
				img(src=assetUrl("./img/vericonomy/verium-logo.svg"), alt="")
				div
					h1 Verium Explorer
					p VRM proof-of-concept explorer powered by the trusted genesis index.
			form.vce-search(method="post", action="./vrm/search")
				input(type="hidden", name="_csrf", value=csrfToken)
				input(type="text", name="query", placeholder="Search VRM block, txid, or address", autocomplete="off", spellcheck="false")
				button(type="submit")
					i.bi-search
					span Search
			.vce-stat-bar
				div
					span Current Block
					strong #{summary.health.heights.maxIndexedHeight == null ? "N/A" : summary.health.heights.maxIndexedHeight.toLocaleString()}
				div
					span Indexed Addresses
					strong #{summary.health.counts.addressCount.toLocaleString()}
				div
					span Blocks Behind
					strong #{summary.health.heights.blocksBehind == null ? "N/A" : summary.health.heights.blocksBehind.toLocaleString()}
				div
					span Trust
					strong #{summary.health.status}

		section.vce-section.vce-split
			.vce-panel
				.vce-panel-head
					h2 Latest Blocks
					span.vce-source #{summary.health.sourceLabels.blocks}
				.vce-table-wrap
					table.vce-table
						thead
							tr
								th Height
								th Hash
								th Tx
								th Time
						tbody
							each block in summary.latestBlocks
								tr
									td
										a(href=`./vrm/block/${block.height}`) #{block.height.toLocaleString()}
									td.vce-mono
										a(href=`./vrm/block/${block.hash}`) #{utils.ellipsizeMiddle(block.hash, 26)}
									td #{block.txCount.toLocaleString()}
									td
										+timestamp(block.time, {agoOptions:{oneElement:true}})

			.vce-panel
				.vce-panel-head
					h2 Top Balances
					a(href="./vrm/richlist") Full richlist
				if (!richlist.enabled && richlist.message)
					.vce-empty #{richlist.message}
				else
					.vce-rank-list
						each item in richlist.items
							a.vce-rank-row(href=`./vrm/address/${item.address}`)
								span ##{item.rank}
								strong.vce-mono #{utils.ellipsizeMiddle(item.address, 20)}
								em #{item.balance.amount} #{item.balance.ticker}

		section.vce-section.vce-split
			.vce-panel
				.vce-panel-head
					h2 Recent Transactions
					span.vce-source #{summary.health.sourceLabels.transactions}
				.vce-table-wrap
					table.vce-table
						thead
							tr
								th Txid
								th Block
								th Type
								th Time
						tbody
							each tx in summary.recentTransactions
								tr
									td.vce-mono
										a(href=`./vrm/tx/${tx.txid}`) #{utils.ellipsizeMiddle(tx.txid, 32)}
									td
										a(href=`./vrm/block/${tx.blockHeight}`) #{tx.blockHeight.toLocaleString()}
									td
										if tx.isCoinbase
											span.vce-chip coinbase
										else if tx.isCoinstake
											span.vce-chip coinstake
										else
											span transfer
									td
										+timestamp(tx.time, {agoOptions:{oneElement:true}})

			.vce-panel
				.vce-panel-head
					h2 Monthly Activity
					a(href="./vrm/leaderboard?period=month&sort=activity") Full leaderboard
				if (!leaderboard.enabled && leaderboard.message)
					.vce-empty #{leaderboard.message}
				else
					.vce-rank-list
						each item in leaderboard.items
							a.vce-rank-row(href=`./vrm/address/${item.address}`)
								span ##{item.rank}
								strong.vce-mono #{utils.ellipsizeMiddle(item.address, 20)}
								em #{item.txCount.toLocaleString()} tx
