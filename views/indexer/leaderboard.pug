extends ../layout

- const base = chainBasePath || "./vrm"
- const meta = chainMeta || { name: "Verium", ticker: "VRM" }

block headContent
	title #{meta.name} Leaderboard

block content
	+pageTitle(`${meta.name} Leaderboard`, "Indexed transfer activity, not guessed mining or staking identity")

	if (!leaderboard.enabled && leaderboard.message)
		+warningAlert
			h6.mb-2 Leaderboard Disabled
			| #{leaderboard.message}
	else
		+contentSection("Filters")
			.d-flex.flex-wrap.gap-2
				a.btn.btn-sm(href="${base}/leaderboard?period=week&sort=net", class=(leaderboard.period.type == "week" && leaderboard.sort == "net" ? "btn-primary" : "btn-outline-primary")) Week Net
				a.btn.btn-sm(href="${base}/leaderboard?period=week&sort=received", class=(leaderboard.period.type == "week" && leaderboard.sort == "received" ? "btn-primary" : "btn-outline-primary")) Week Received
				a.btn.btn-sm(href="${base}/leaderboard?period=week&sort=activity", class=(leaderboard.period.type == "week" && leaderboard.sort == "activity" ? "btn-primary" : "btn-outline-primary")) Week Activity
				a.btn.btn-sm(href="${base}/leaderboard?period=month&sort=net", class=(leaderboard.period.type == "month" && leaderboard.sort == "net" ? "btn-primary" : "btn-outline-primary")) Month Net
				a.btn.btn-sm(href="${base}/leaderboard?period=month&sort=received", class=(leaderboard.period.type == "month" && leaderboard.sort == "received" ? "btn-primary" : "btn-outline-primary")) Month Received
				a.btn.btn-sm(href="${base}/leaderboard?period=month&sort=activity", class=(leaderboard.period.type == "month" && leaderboard.sort == "activity" ? "btn-primary" : "btn-outline-primary")) Month Activity

		+contentSection("Source")
			+summaryRow(4)
				+summaryItem("Trust")
					span.badge(class=(leaderboard.trusted ? "bg-success" : "bg-warning text-dark")) #{leaderboard.source.healthStatus}
				+summaryItem("Label")
					span.badge.bg-primary #{leaderboard.label}
				+summaryItem("Period")
					| #{leaderboard.period.type}
				+summaryItem("Sort")
					| #{leaderboard.sort}

		+contentSection("Activity")
			.table-responsive
				table.table.table-sm.align-middle
					thead
						tr
							th Rank
							th Address
							th.text-end Received
							th.text-end Sent
							th.text-end Net
							th.text-end Tx
							th.text-end Last Seen
					tbody
						each item in leaderboard.items
							tr
								td ##{item.rank}
								td.font-monospace
									a(href=`${base}/address/${item.address}`) #{item.address}
								td.text-end #{item.received.amount} #{item.received.ticker}
								td.text-end #{item.sent.amount}
								td.text-end(class=(item.netAtomic.startsWith("-") ? "text-danger" : "text-success")) #{item.net.amount}
								td.text-end #{item.txCount.toLocaleString()}
								td.text-end
									if item.lastSeenHeight != null
										a(href=`${base}/block/${item.lastSeenHeight}`) #{item.lastSeenHeight.toLocaleString()}
									else
										| N/A

			.d-flex.justify-content-between
				div
					if leaderboard.paging.offset > 0
						a.btn.btn-outline-primary.btn-sm(href=`${base}/leaderboard?period=${leaderboard.period.type}&sort=${leaderboard.sort}&limit=${limit}&offset=${Math.max(0, leaderboard.paging.offset - limit)}`) Previous
				div
					if leaderboard.paging.hasMore
						a.btn.btn-outline-primary.btn-sm(href=`${base}/leaderboard?period=${leaderboard.period.type}&sort=${leaderboard.sort}&limit=${limit}&offset=${leaderboard.paging.offset + limit}`) Next
