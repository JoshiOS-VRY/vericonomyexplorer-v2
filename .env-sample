# Copy to .env and adjust RPC credentials.
# Verium RPC: 127.0.0.1:33987 (P2P network port is 36988)
# VeriCoin RPC: 127.0.0.1:58683 (P2P network port is 58684)

BTCEXP_HOST=127.0.0.1
BTCEXP_PORT=3002
BTCEXP_COIN=VRM

BTCEXP_BITCOIND_HOST=127.0.0.1
BTCEXP_BITCOIND_PORT=33987
BTCEXP_BITCOIND_USER=verium
BTCEXP_BITCOIND_PASS=replace-me
BTCEXP_BITCOIND_RPC_TIMEOUT=10000
BTCEXP_SLOW_DEVICE_MODE=false
BTCEXP_RPC_CONCURRENCY=20

BTCEXP_UI_THEME=dark

# Lean explorer-api (Fastify, port 3003)
VCEXP_FAST_API_PORT=3003
EXPLORER_FAST_API_URL=http://127.0.0.1:3003
VCEXP_VRM_ZMQ=tcp://127.0.0.1:28332
VCEXP_VRC_ZMQ=tcp://127.0.0.1:28333
VCEXP_TIP_POLL_MS=3000

VCEXP_INDEXER_SQLITE_PATH=database/vericonomy-index.sqlite
VCEXP_CHAINS_CONFIG=./configs/chains.json

VCEXP_VRM_RPC_USER=verium
VCEXP_VRM_RPC_PASS=replace-me
# VCEXP_VRM_RPC_HOST=127.0.0.1

VCEXP_VRC_RPC_USER=vericoin
VCEXP_VRC_RPC_PASS=replace-me
# VCEXP_VRC_RPC_HOST=127.0.0.1

# Dev performance (optional)
# Longer API cache TTL reduces cold SQLite hits while iterating locally
VCEXP_API_CACHE_TTL_MS=300000
# Checkpoint WAL when the -wal file exceeds this size (MB)
VCEXP_WAL_CHECKPOINT_MB=512
# Read-only SQLite worker threads in explorer-api
VCEXP_API_DB_WORKERS=4
VCEXP_API_DB_FAST_WORKERS=2
VCEXP_API_DB_WORKER_TIMEOUT_MS=60000
VCEXP_SQLITE_BUSY_RETRY_ATTEMPTS=6
VCEXP_SQLITE_BUSY_RETRY_DELAY_MS=100

# Indexer / backfill concurrency (cooperative with live site)
VCEXP_INDEXER_YIELD_MS=50
VCEXP_INDEXER_BLOCKS_PER_PASS=50
VCEXP_INDEX_ONLY_RPC_BATCH=25
VCEXP_INDEXER_BUSY_TIMEOUT_MS=30000
VCEXP_WAL_CHECKPOINT_MODE=PASSIVE
VCEXP_BACKFILL_COOPERATIVE=1
VCEXP_BACKFILL_YIELD_MS=50
VCEXP_BACKFILL_STATS_BATCH_SIZE=500
VCEXP_BACKFILL_WRITE_BATCH=250

# Market data (LiveCoinWatch — server-side only, never expose to browser)
VCEXP_LCW_API_KEY=
VCEXP_MARKET_CACHE_TTL_MS=120000
# Optional CoinGecko Pro key for BTC reference / VRC fallback
VCEXP_COINGECKO_API_KEY=
