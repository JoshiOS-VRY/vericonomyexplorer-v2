# Copy to .env and adjust RPC credentials.
# Verium RPC: 127.0.0.1:33987 (P2P network port is 36988)
# VeriCoin RPC: 127.0.0.1:58683 (P2P network port is 58684)

BTCEXP_HOST=127.0.0.1
BTCEXP_PORT=3002
BTCEXP_COIN=VRM

BTCEXP_BITCOIND_HOST=127.0.0.1
BTCEXP_BITCOIND_PORT=33987
BTCEXP_BITCOIND_USER=verium
BTCEXP_BITCOIND_PASS=replace-me
BTCEXP_BITCOIND_RPC_TIMEOUT=10000
BTCEXP_SLOW_DEVICE_MODE=false
BTCEXP_RPC_CONCURRENCY=20

BTCEXP_UI_THEME=dark

# Lean explorer-api (Fastify, port 3003)
VCEXP_FAST_API_PORT=3003
EXPLORER_FAST_API_URL=http://127.0.0.1:3003
VCEXP_VRM_ZMQ=tcp://127.0.0.1:28332
VCEXP_VRC_ZMQ=tcp://127.0.0.1:28333
VCEXP_TIP_POLL_MS=3000

VCEXP_INDEXER_SQLITE_PATH=database/vericonomy-index.sqlite
VCEXP_CHAINS_CONFIG=./configs/chains.json

VCEXP_VRM_RPC_USER=verium
VCEXP_VRM_RPC_PASS=replace-me

VCEXP_VRC_RPC_USER=vericoin
VCEXP_VRC_RPC_PASS=replace-me
