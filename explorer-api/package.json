{
  "name": "explorer-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "bench": "node bench/tip.mjs",
    "bench:hotpaths": "node bench/hotpaths.mjs",
    "bench:explain": "node bench/explain-hotpaths.mjs",
    "postinstall": "node -e \"console.log('explorer-api uses better-sqlite3 from repo root; run npm rebuild better-sqlite3 at repo root if native module errors appear.')\""
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.0",
    "lru-cache": "^11.1.0",
    "undici": "^7.16.0",
    "zeromq": "^6.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.0",
    "autocannon": "^8.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
