{
  "name": "explorer-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "npm run format:check && tsc",
    "test": "node --test --import tsx test/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bench": "node bench/tip.mjs",
    "bench:hotpaths": "node bench/hotpaths.mjs",
    "bench:explain": "node bench/explain-hotpaths.mjs",
    "update:all": "ncu -u && npm install",
    "postinstall": "node -e \"console.log('explorer-api uses better-sqlite3 from repo root; run npm rebuild better-sqlite3 at repo root if native module errors appear.')\""
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@vericonomy/network-metrics": "file:../../packages/network-metrics",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "ioredis": "^5.11.0",
    "lru-cache": "^11.5.1",
    "pg": "^8.13.1",
    "pg-copy-streams": "^6.0.6",
    "undici": "^7.26.0",
    "zeromq": "^6.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.11.10",
    "autocannon": "^8.0.0",
    "npm-check-updates": "^18.0.1",
    "prettier": "^3.6.2",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
