{
	"name": "vericonomy-dual-explorer",
	"version": "3.5.1",
	"description": "Open-source, self-hosted dual VeriCoin and Verium explorer",
	"private": false,
	"bin": "bin/cli.js",
	"scripts": {
		"start": "node ./bin/www",
		"dev": "npm run web:dev",
		"web:dev": "npm --prefix explorer-web run dev",
		"web:build": "npm --prefix explorer-web run build",
		"web:start": "npm --prefix explorer-web run start",
		"dev:full": "concurrently -n api,indexer-vrc,indexer-vrm,web -c blue,cyan,magenta,green \"npm run api:dev\" \"npm run indexer:vrc\" \"npm run indexer:vrm\" \"npm run web:dev\"",
		"api:dev": "npm --prefix explorer-api run dev",
		"api:rebuild-native": "npm rebuild better-sqlite3",
		"api:bench": "npm --prefix explorer-api run bench",
		"indexer:vrc": "node ./bin/indexer-v2-loop.js --chain vrc --batch-size 100 --pause-ms 500",
		"indexer:vrm": "node ./bin/indexer-v2-loop.js --chain vrm",
		"indexer:v2": "node ./bin/indexer-v2.js",
		"indexer:v2:repair": "node ./bin/indexer-repair.js",
		"indexer:v2:rollback": "node ./bin/indexer-rollback.js",
		"indexer:v2:status": "node ./bin/indexer-status.js",
		"indexer:v2:repair-smoke": "node ./app/indexerV2/repairSmoke.js",
		"indexer:v2:rollback-smoke": "node ./app/indexerV2/rollbackSmoke.js",
		"indexer:v2:reorg-smoke": "node ./app/indexerV2/reorgAutoSmoke.js",
		"indexer:v2:query-smoke": "node ./app/indexerV2/querySmoke.js",
		"indexer:checkpoint": "node ./bin/indexer-checkpoint.js",
		"indexer:v2:smoke": "node ./app/indexerV2/smoke.js",
		"test": "node ./bin/test.js",
		"miners": "node ./bin/refresh-mining-pool-configs.js",
		"integrity": "node ./bin/frontend-resource-integrity.js",
		"lint": "eslint app routes",
		"css-light-debug": "sass --style expanded ./public/scss/light.scss ./public/style/light.css",
		"css-dark-debug": "sass --style expanded ./public/scss/dark.scss ./public/style/dark.css",
		"css-dark-v1-debug": "sass --style expanded ./public/scss/dark-v1.scss ./public/style/dark-v1.css",
		"css-debug": "npm run css-light-debug && npm run css-dark-debug && npm run css-dark-v1-debug",
		"css-light": "sass --style compressed ./public/scss/light.scss ./public/style/light.min.css",
		"css-dark": "sass --style compressed ./public/scss/dark.scss ./public/style/dark.min.css",
		"css-dark-v1": "sass --style compressed ./public/scss/dark-v1.scss ./public/style/dark-v1.min.css",
		"css": "npm run css-light && npm run css-dark && npm run css-dark-v1 && npm run integrity"
	},
	"keywords": [
		"vericoin",
		"verium",
		"vericonomy",
		"blockchain",
		"blockchain-explorer"
	],
	"author": "VeriConomy",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/VeriConomy/vericonomy-dual-explorer.git"
	},
	"dependencies": {
		"@janoside/app-utils": "github:janoside/app-utils#ba4c23d3f",
		"async": "^3.2.6",
		"axios": "^1.11.0",
		"basic-auth": "^2.0.1",
		"bech32": "2.0.0",
		"better-sqlite3": "^12.4.1",
		"bip32": "^4.0.0",
		"bitcoinjs-lib": "^6.1.7",
		"body-parser": "^2.2.0",
		"bootstrap": "^5.3.7",
		"bs58check": "^4.0.0",
		"chart.js": "^4.5.0",
		"compression": "^1.8.1",
		"cookie-parser": "^1.4.7",
		"crypto-js": "^4.2.0",
		"csurf": "^1.11.0",
		"debug": "^4.4.1",
		"decimal.js": "^10.6.0",
		"dotenv": "^13.0.1",
		"electrum-client": "github:janoside/electrum-client",
		"express": "^4.21.2",
		"express-async-handler": "^1.2.0",
		"express-rate-limit": "^8.0.1",
		"express-session": "^1.18.2",
		"jayson": "^4.2.0",
		"lru-cache": "^10.4.3",
		"markdown-it": "^14.1.0",
		"md5": "^2.3.0",
		"memorystore": "^1.6.7",
		"meow": "^9.0.0",
		"moment": "^2.30.1",
		"moment-duration-format": "^2.3.2",
		"morgan": "^1.10.1",
		"on-headers": "^1.1.0",
		"pidusage": "^4.0.1",
		"pug": "^3.0.3",
		"qrcode": "^1.5.4",
		"redis": "^4.7.1",
		"semver": "^7.7.2",
		"serve-favicon": "^2.5.1",
		"simple-git": "^3.28.0",
		"tiny-secp256k1": "^2.2.4",
		"zeromq": "^6.5.0"
	},
	"optionalDependencies": {
		"event-loop-stats": "^1.4.1"
	},
	"devDependencies": {
		"concurrently": "^9.2.1",
		"eslint": "^9.34.0",
		"sass": "^1.90.0",
		"sharp": "^0.34.5"
	}
}
